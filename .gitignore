# Environment files
.env
.env.backup
.env.production
.env.local
*.env
!.env.example

# Backend dependencies & cache
/backend/vendor/
/backend/node_modules/
/backend/bootstrap/cache/*.php
!/backend/bootstrap/cache/.gitkeep
/backend/storage/logs/*.log
!/backend/storage/logs/.gitkeep
/backend/storage/framework/cache/data/*
